// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id               String    @id @default(cuid())
  name             String
  followers        String
  status           String    @default("Active")
  image            String
  platform         String    @default("Instagram")
  igUserId         String?   @unique
  pageId           String?
  pageAccessToken  String?
  tokenExpiresAt   DateTime?
  createdAt        DateTime  @default(now())
}

model Keyword {
  id        String   @id @default(cuid())
  text      String   @unique
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // 'string', 'boolean', 'number'
}

model AutoDm {
  id               String   @id @default(cuid())
  name             String   @default("Untitled Automation")
  channel          String   @default("instagram") // 'instagram' | 'messenger'
  sourceType       String   // 'post_reel' | 'story' | 'live' | 'dm' | 'dm_post'
  content          Json?    // snapshot of the selected post/reel/story/live, or null
  triggerMode      String   @default("keyword") // 'keyword' | 'any'
  keywords         Json     @default("[]")
  excludedKeywords Json     @default("[]")
  autoReplyEnabled Boolean  @default(false)
  autoReplyText    String   @default("")
  delayValue       Int      @default(1)
  delayUnit        String   @default("Minute") // 'Minute' | 'Hour'
  askFollow        Boolean  @default(false)
  askFollowOpeningMessage  String @default("")
  askFollowCheckMessage    String @default("")
  askFollowRetryCount      Int    @default(3)
  askFollowFallback        String @default("send") // 'send' | 'dont_send'
  askEmail         Boolean  @default(false)
  askEmailMessage  String   @default("")
  dmType           String   @default("text_button") // 'text' | 'text_button'
  messageText      String   @default("")
  buttonText       String   @default("")
  buttonUrl        String   @default("")
  followUpMessages Json     @default("[]")
  status           String   @default("active") // 'active' | 'paused' | 'draft'
  triggerCount     Int      @default(0)
  messagesSent     Int      @default(0)
  uniqueUsers      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  events           AutoDmEvent[]
}

model AutoDmEvent {
  id            String   @id @default(cuid())
  autoDmId      String
  autoDm        AutoDm   @relation(fields: [autoDmId], references: [id], onDelete: Cascade)
  contactName   String
  contactAvatar String
  triggerText   String
  messagesSent  Int      @default(1)
  createdAt     DateTime @default(now())
}
