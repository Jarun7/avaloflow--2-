# Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Meta (Facebook/Instagram) App credentials
# Create an app at https://developers.facebook.com/apps, add the
# "Facebook Login for Business" and "Instagram Graph API" products.
META_APP_ID=
META_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" configured on the app,
# e.g. http://localhost:3000/api/meta/callback for local dev.
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
# From Facebook Login for Business > Configurations > (your configuration).
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v21.0
# Any string you choose; used to verify webhook requests from Meta.
META_WEBHOOK_VERIFY_TOKEN=
